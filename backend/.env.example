# Server Configuration
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000

# MySQL Database Configuration (Aiven / Localhost / TiDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=medicore

# SSL (Set to true for Aiven Cloud MySQL, false for local MySQL)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Prisma Database Connection URL
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Authentication Secret (Change this in production to a secure 32+ character random string)
JWT_SECRET=medicore_development_jwt_secret_key_2026

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# SSLCommerz Sandbox Configuration
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASS=qwerty
SSLCOMMERZ_IS_SANDBOX=true

# TOTP Secret for Admin Login
TOTP_SHARED_SECRET=VO3W7H2JT7N2HPUNE3QU2MGTKJVHBGXK
